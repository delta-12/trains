import {Palette, StandardTableView, TextEdit, ScrollView, GridBox, TabWidget, ComboBox, Button, ProgressIndicator, Switch, VerticalBox, ListView, Spinner, SpinBox, HorizontalBox, LineEdit} from "std-widgets.slint";

//enter filename field for custom PLC
export component EnterFilename inherits Window {

    in-out property <string> plcprog;
    callback select_file();
    callback parse_file();

    width: 153px;
    height: 27px;
    x: 163px;
    y: 52px;
    LineEdit {
        font-size: 14px;
        width: parent.width;
        height: parent.height;
        placeholder-text: "Enter filename";

        edited(input) => {plcprog = input}

    }
    Button {

        text: "Load PLC";
        x: 190px;
        clicked => {parse_file()}

    }
}

//table view SW - DEFAULT
component BlockLayoutMap inherits Rectangle {
    background: #252525;
    border-radius: 10px;
    preferred-height: 180px;
    in-out property <[[StandardListViewItem]]> block_data;
    in-out property <string> section;
    in-out property <string> block;
    in-out property <bool> mode: true;
    in-out property <bool> crossing: true;
    in-out property <bool> signal: true;

    in-out property <bool> switch: false;
    in-out property <bool> occupancy: false;
    in-out property <string> failure;
    VerticalLayout {

        ScrollView{
            height: 250px;
            viewport-width: 675px;
            viewport-height: 500px;

        VerticalLayout {
            padding: 15px;
            StandardTableView {
                columns: [
                    { title: @tr("Section") },
                    { title: @tr("Block") },
                    { title: @tr("Occupancy") },
                    { title: @tr("Crossing") },
                    { title: @tr("Signal State") },
                    { title: @tr("Switch State") },
                ];
                rows: block_data;
            }
        }
    }
        ManageBlock := HorizontalLayout {
            alignment: start;
            padding: 15px;
            spacing: 10px;
            LineEdit {
                width: 130px;
                height: 30px;
                placeholder-text: @tr("Block Line, Number");
                edited(input) => { section = input }
            }
            LineEdit {
                width: 130px;
                height: 30px;
                placeholder-text: @tr("Switch Orientation");
                edited(input) => { section = input }
            }
            HorizontalLayout {
                Switch {
                    toggled => {mode = !mode}
                }
                Text {text:"  Occupancy"; y: 7px;}
            }
            HorizontalLayout {
                Switch {
                    toggled => {crossing = !crossing}
                }
                Text {text:" Crossing"; y: 7px;}
            }
            HorizontalLayout {
                Switch {
                    toggled => {signal = !signal}
                }
                Text {text:"  Signal"; y: 7px;}
            }
            
        }
    }
}

//combo 1 - SW vs HW WC
export component WCType inherits ComboBox {

    in-out property <string> sworhw;
    in-out property <bool> selectWayside: true;
    callback selectWCType();

    width: self.preferred-width;
    x: 400px;
    y: 50px;
    height: self.preferred-height * 2;
    model: ["Software Wayside Controller", "Hardware Wayside Controller"];
    current-value: "Software Wayside Controller";

    selected(item) => {
        sworhw = item;

        if(item == "Software Wayside Controller"){
            selectWayside = true;
        } else if(item == "Hardware Wayside Controller"){
            selectWayside = false;
        }
    }


    
}
//combo 2 - Redline vs Greenline
export component LineType inherits ComboBox {
 
    in-out property <string> redorgreen;
    in-out property <bool> selectLine: true;

    callback selectLineType();

    width: self.preferred-width;
    x: 625px;
    y: 50px;
    height: self.preferred-height * 2;
    model: ["Green Line", "Red Line"];
    current-value: "Green Line";

    selected(item) => {
        redorgreen = item;

        if(item == "Software Wayside Controller"){
            selectLine = true;
        } else if(item == "Hardware Wayside Controller"){
            selectLine = false;
        }
    }


}
//show button
export component ShowButton inherits Button {
    
    callback load_block_data();

    text: "Show Track Blocks";
    x: 499px;
    y: 100px;

    
}

