               clicked => {load_block_data()}
            }

        ///////////// former second tab - converted into a table

        BlockLayoutMap {
        width: 678px;
        x: 50px;
        y: 200px;
      
        } // Transit System Top Widget  
        
        
    } ///
    



////////////////////TESTBENCH INPUTS////////////////////////////////////////


    Rectangle {
