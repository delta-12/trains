                                    text: "Authority:";
                                    vertical-alignment: center;
                                    font-size: 20px;
                                    preferred-width: 250px;
                                }
                                LineEdit {
                                    text: passengers_boarding;
                                    font-size: 20px;
                                    max-height: 200px;
                                    horizontal-alignment: center;
                                    read-only: true;
                                    //vertical-alignment: center;
                                }
                                Text {
                                    text: "meters";
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    font-size: 20px;
                                    preferred-width: 250px;
                                }
                            }
                            //Commanded Speed
                            HorizontalBox {
                                Text {
                                    text: "Commanded Speed:";
                                    vertical-alignment: center;
                                    font-size: 20px;
                                    preferred-width: 250px;
                                }
                                LineEdit {
                                    text: passengers_boarding;
                                    font-size: 20px;
                                    max-height: 200px;
                                    horizontal-alignment: center;
                                    read-only: true;
                                    //vertical-alignment: center;
                                }
                                Text {
                                    text: "m/s";
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    font-size: 20px;
                                    preferred-width: 250px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

