import { HorizontalBox, TextEdit, Button, GroupBox, Switch, TabWidget, StandardTableView, LineEdit, VerticalBox, ComboBox } from "std-widgets.slint";

component TrackInput inherits Rectangle {
    in-out property<string> fileName: "";
    callback choose-file();
    callback parse-file();
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        HorizontalLayout {
            alignment: start;
            Text { font-size: 20px; text: "Choose Track Layout File: ";}
            Rectangle {width: 10px;}
            Rectangle {
                border-radius: 5px;
                y: -3px;
                width: 150px;
                height: 25px;
                border-width: 2px;
                border-color: #4d4d4d;
                Text {text: fileName;}
            } 
        }
        HorizontalLayout {
            Button {
                max-width: 400px;
                max-height: 30px;
                text: "Open File";
                clicked => {choose-file()}
            }
        }
        HorizontalLayout {
            Button { 
                max-width: 400px;
                max-height: 30px;
                text: "Execute";
                clicked => {parse-file()}
            } 
        }       
    }
}
