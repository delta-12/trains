import { HorizontalBox, Button, GroupBox, Switch, TabWidget, StandardTableView, LineEdit, VerticalBox, StandardListView, ScrollView, ComboBox } from "std-widgets.slint";

component TransitSystem inherits Rectangle {
    background: #252525;
    border-radius: 10px;
    preferred-height: 300px;
    in-out property <[[StandardListViewItem]]> block_data;
    in-out property <string> block_id;
    in-out property <bool> block_maintenance_mode;
    in-out property <bool> maintenance_switch_mode;
    in-out property <bool> switch;
    in-out property <string> time;
    in-out property <bool> switch_enabled;
    in-out property <bool> has_input;
    in-out property <bool> green_line: true;
    in-out property <string> simulation_speed;

    callback set_switch_position();
    callback set_maintenance_mode();
    callback fix_block();
    callback set_simulation_speed();

    VerticalLayout {
        padding-top: 10px;
        HorizontalLayout {
            padding-top: 7px;
            padding-left: 15px;
            spacing: 20px;
            Text { 
                font-size: 20px;
                font-weight: 500;
                text: "Transit System";
            }
            HorizontalLayout {
                Text {font-size: 20px; text: "Time: ";}
                Rectangle {
                    border-radius: 5px;
                    y: -3px;
                    width: 120px;
                    height: 35px;
                    border-width: 2px;
                    border-color: #4d4d4d;
                    Text {text: time;}
                }
            }
            HorizontalLayout {
                Text {font-size: 20px;text: "Throughput: ";}
                Rectangle {
                    border-radius: 5px;
                    y: -3px;
                    width: 120px;
                    height: 35px;
                    border-width: 2px;
                    border-color: #4d4d4d;
                    Text {text: "Train/hr/line";}
                }
            }
            HorizontalLayout {
                alignment: end;
                padding-right: 15px;
                ComboBox {
                    y: -3px;
                    model: [@tr("Simulation Speed"), "x1", "x10", "x50"];
                    selected(input) => {
                        simulation_speed = input;
                        set_simulation_speed();
                    }
                }
            }
        }
        VerticalLayout {
            padding: 15px;
            StandardTableView {
                columns: [
                    { title: @tr("Section") },
                    { title: @tr("Block") },
                    { title: @tr("Mode") },
                    { title: @tr("Switch") },
                    { title: @tr("Occupany") },
                    { title: @tr("Failure") },
                ];
                rows: block_data;
            }
        }
        ManageBlock := HorizontalLayout {
            alignment: start;
            padding: 15px;
            spacing: 20px;
            LineEdit {
                width: 120px;
                height: 30px;
                placeholder-text: @tr("Block");
                edited(input) => { 
                    block_id = input; 
                    if (block_id == "") {
                        has_input = false;
                    } else {
                        has_input = true;
                    }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Switch {
                    enabled: has_input;
                    checked: block_maintenance_mode;
                    toggled => {
                        maintenance_switch_mode = !maintenance_switch_mode;
                        if (maintenance_switch_mode == true) {
                            switch_enabled = true;
                            set_maintenance_mode();
                        } else {
                            switch_enabled = false;
                            fix_block();
                        }
                    }
                }
                Text {text:"  Maintenance Mode"; y: 7px;}
            }
            HorizontalLayout {
                spacing: 5px;
                Switch {
                    enabled: switch_enabled;
                    toggled => {
                        switch = !switch;
                        set_switch_position();
                    }
                }
                Text {text:" Switch"; y: 7px;}
            }
            HorizontalLayout {
                spacing: 5px;
                padding-left: 200px;
                Button {
                    width: 100px;
                    text: green_line ? " Green Line" : "Red Line";  
                    clicked => {green_line = !green_line}
                }
            }
        }
    }
}

component TrainSchedule inherits Rectangle {
    background: #252525;
    border-radius: 10px;
    preferred-width: 150px;
    preferred-height: 400px;
    in-out property <[[StandardListViewItem]]> train_schedules;
    VerticalLayout {
        alignment: stretch;
        padding-top: 10px;
        HorizontalLayout {
            padding-left: 15px;
            spacing: 20px;
            Text { 
                font-size: 20px;
                font-weight: 500;
                text: "Train Schedule";
            }
        }
        VerticalLayout {
            padding: 15px;
            StandardTableView {
                columns: [
                    { title: @tr("Train") },
                    { title: @tr("Position") },
                    { title: @tr("Authority (blocks)") },
                    { title: @tr("S.Speed (m/s)") },
                    { title: @tr("DST(s)") },
                ];
                rows: train_schedules;
            }
        }
    }
}

component ManualMode inherits Rectangle {
    in-out property <string> train_id;
    in-out property <string> arrival_station;
    in-out property <string> arrival_time;
    in-out property <[string]> stations;
    in-out property <[string]> trains;
    in-out property <string> dispatch_message;
    callback manual-dispatch();
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        HorizontalLayout {
            alignment: start;
            Text { font-size: 15px; text: "Train:            ";}
            Rectangle {width: 10px;}
            ComboBox {
                height: 30px;
                y: -3px;
                model: trains;
                current-value: train_id;
                selected(input) => {train_id = input}
            } 
        }
        HorizontalLayout {
            alignment: start;
            Text { font-size: 15px; text: "Stations:       ";}
            Rectangle {width: 10px;}
            ComboBox {
                height: 30px;
                y: -3px;
                model: stations;
                current-value: arrival_station;
                selected(input) => {arrival_station = input}
            } 
        }
        HorizontalLayout {
            alignment: start;
            Text { font-size: 15px;text: "Arrival Time: ";}
            Rectangle {width: 10px;}
            LineEdit {
                height: 30px;
                placeholder-text: @tr("10:00:00");
                edited(input) => {arrival_time = input}
            } 
        }
        HorizontalLayout {
            Text {text: dispatch_message;}
        }
        VerticalLayout {
            alignment: end; 
            Button { 
                max-height: 30px;
                preferred-width: 250px;
                text: "DISPATCH";
                clicked => {manual-dispatch()}
            } 
        }
    }
}

component AutomaticMode inherits Rectangle {
    in-out property<string> fileName: "";
    callback choose-file();
    callback parse-file();
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        HorizontalLayout {
            alignment: start;
            Text { text: "Choose File: ";}
            Rectangle {width: 10px;}
            Rectangle {
                border-radius: 5px;
                y: -3px;
                width: 150px;
                height: 25px;
                border-width: 2px;
                border-color: #4d4d4d;
                Text {text: fileName;}
            } 
        }
        HorizontalLayout {
            Button { 
                max-height: 30px;
                text: "Open File";
                clicked => {choose-file()}
            }
        }
        
        VerticalLayout {
            alignment: end; 
            Button { 
                max-height: 30px;
                preferred-width: 250px;
                text: "DISPATCH";
                clicked => {parse-file()}
            } 
        }       
    }
}

component Dispatch inherits Rectangle {
    property <bool> automatic_mode: true;
    in-out property<string> fileName: "";
    in-out property <string> train_id;
    in-out property <string> arrival_station;
    in-out property <string> arrival_time;
    in-out property <[string]> stations;
    in-out property <[string]> trains;
    in-out property <string> dispatch_message;

    callback choose-file();
    callback parse-file();
    callback manual-dispatch();

    background: #252525;
    border-radius: 10px;
    
    VerticalLayout {
        padding: 10px;
        spacing: 15px;
        alignment: stretch;
        Rectangle {
            height: 30px;
            // background: red;
            HorizontalLayout {
                Text { 
                    font-size: 20px;
                    font-weight: 500;
                    text: "Dispatch";
                }
            }
        }
        Rectangle {
            height: 30px;
            // background: green;
            HorizontalLayout {
                
                Button {
                    padding: 10px;
                    height: 35px;
                    clicked => {automatic_mode = !automatic_mode;}
                    enabled: automatic_mode;
                    text: automatic_mode ? "Automatic Mode" : "Manual Mode";
                }
            }
        }

        if(automatic_mode == true) : AutomaticMode {
            choose-file => {root.choose-file()}
            parse-file => {root.parse-file()}
            fileName: fileName;
        }
        if(automatic_mode == false) : ManualMode {
            train_id <=> train_id;
            trains <=> trains;
            arrival_station <=> arrival_station;
            stations: stations;
            arrival_time <=> arrival_time;
            manual-dispatch => {manual-dispatch()}
            dispatch_message: dispatch_message;
        }    
    }
}

component TBInputs inherits Rectangle {
    in-out property <string> block_occupancy;
    in-out property <bool> occupied;
    in-out property <string> confirm_occupancy_message;
    // Callbacks
    callback send_occupancy_signal();
    callback send_failure_signal();
    callback wc_send_block_states();
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        WaysideOccupancy := VerticalLayout {
            spacing: 10px;
            Text {font-size: 20px; text: "Wayside Occupancy Signal:";}
            LineEdit {
                height: 50px;
                placeholder-text: @tr("Block Number");
                edited(input) => {block_occupancy = input}
            }
            Switch {
                checked: occupied;
                text: "Occupied";
                toggled => {occupied = !occupied}
            }
            Button {
                height: 40px;
                text: "Send Occupancy Signal";
                clicked => {send_occupancy_signal()}
            }
            Text {
                text: confirm_occupancy_message;
            }
            Button {
                height: 40px;
                text:  "Send Failure Signal";
                clicked => {
                    send_failure_signal();
                }
            }
            Text {
                text: confirm_occupancy_message;
            }
        }
    }
}

export component CtcUi inherits Window {
    in-out property <string> selected_fileName;
    in-out property <[[StandardListViewItem]]> block_data;
    in-out property <[[StandardListViewItem]]> train_schedules;
    in-out property <string> arrival_time;
    in-out property <string> maintenance_section;
    in-out property <string> maintenance_block;

    //Transit System
    in-out property <bool> block_maintenance_mode;
    in-out property <bool> switch_state;
    in-out property <string> failure_signal;
    in-out property <string> time;
    in-out property <string> block_id;
    in-out property <string> simulation_speed;

    //Dispatch 
    in-out property <bool> file_chosen;
    in-out property <[string]> stations;
    in-out property <string> train_id;
    in-out property <[string]> trains;
    in-out property <string> arrival_station;
    in-out property <string> dispatch_message;

    //TestBench
    in-out property <string> block_occupancy;
    in-out property <string> train_tb;
    in-out property <[string]> trains_tb;
    in-out property <bool> occupied;

    in-out property <int> authority;
    in-out property <int> suggested_speed;
    in-out property <string> dwell_time;
    in-out property <string> confirm_occupancy_message;
    in-out property <string> confirm_output_message;
    in-out property <string> confirm_maintenance_message;

    // Transit callbacks
    callback reflect_operation_mode();
    callback set_maintenance_mode();
    callback fix_block();
    callback set_simulation_speed();
    callback set_switch_position();

    callback send_occupancy();
    callback print-output-to-wayside();
    callback print-maintenance-message();
    callback print-switch-message();
    callback print-automatic-dispatch();
    callback send-failure-signal();

    callback choose-file();
    callback parse-file();
    callback manual-dispatch();

    // Testbench 
    callback show-train-output();
    callback wc_send_block_states();
    

    title: "CTC Office";
    preferred-width: 600px;
    preferred-height: 600px;
    TabWidget {
        Tab {
            title: @tr("CTC Home");
            
            VerticalLayout {
                padding: 15px;
                spacing: 15px;
                alignment: stretch;
                TransitSystem {
                    simulation_speed <=> simulation_speed;
                    block_data: block_data;
                    time: time;
                    block_id <=> block_id;
                    block_maintenance_mode <=> block_maintenance_mode;
                    switch <=> switch_state;
                    set_switch_position => {root.set_switch_position()}
                    set_maintenance_mode => {root.set_maintenance_mode()}
                    fix_block => {root.fix_block()}
                    set_simulation_speed => {root.set_simulation_speed()}
                } // Transit System Top Widget
                HorizontalLayout { // Bottom Widget Containing Train Schedule and Dispatch
                    spacing: 15px;
                    alignment: stretch;
                    TrainSchedule {
                        train_schedules <=> train_schedules;
                    }
                    Dispatch { // Bottom Right Dispatch
                        fileName: selected_fileName;
                        choose-file => {root.choose-file();}
                        parse-file => {root.parse-file()}
                        stations <=> stations;
                        train_id <=> train_id;
                        trains <=> trains;
                        arrival_station <=> arrival_station;
                        arrival_time <=> arrival_time;
                        dispatch_message: dispatch_message;
                        manual-dispatch => {root.manual-dispatch()}
                    }
                }   
            }
        }
        Tab {
            title: @tr("Test Bench");
            HorizontalLayout {
                padding: 15px;
                spacing: 20px;
                Rectangle {
                    background: #252525;
                    border-radius: 10px;
                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        padding-left: 15px;
                        Text {
                            font-size: 20px;
                            font-weight: 500;
                            text: "Inputs";
                        }
                        TBInputs {
                            occupied <=> occupied;
                            block_occupancy <=> block_occupancy;
                            confirm_occupancy_message: confirm_occupancy_message;
                            send_occupancy_signal => {root.send_occupancy()}
                            send_failure_signal => {root.send-failure-signal()}
                            wc_send_block_states => {root.wc_send_block_states()}
                        }     
                    }
                } 
                Rectangle {
                    background: #252525;
                    border-radius: 10px;
                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        padding-left: 15px;
                        Text {
                            font-size: 20px;
                            font-weight: 500;
                            text: "Outputs";
                        }
                        VerticalBox {
                            padding-bottom: 20px;
                            HorizontalLayout {
                                alignment: start;
                                Text { font-size: 15px; text: "Train:            ";}
                                Rectangle {width: 10px;}
                                ComboBox {
                                    height: 30px;
                                    y: -3px;
                                    model: trains_tb;
                                    current-value: train_tb;
                                    selected(input) => { 
                                        train_tb = input;
                                        root.show-train-output();
                                    }
                                } 
                            }
                            Text {
                                font-size: 20px;
                                text: "Suggested Speed (m/s): \{root.suggested_speed}";
                            }
                            Text {
                                font-size: 20px;
                                text: "Authority (# blocks): \{root.authority}";
                            }
                        }
                        VerticalBox {
                            padding-bottom: 20px;
                            Text {
                                font-size: 20px;
                                text: "Section: \{block_maintenance_mode ? maintenance_section : ""}";
                            }
                            Text {
                                font-size: 20px;
                                text: "Block: \{block_maintenance_mode ? maintenance_block : ""}";
                            }
                            Text {
                                font-size: 20px;
                                text: "Mainteance Signal: \{block_maintenance_mode ? "True" : "False" }" ;
                            }
                        }
                        VerticalBox {
                            padding-bottom: 20px;
                            Text {
                                font-size: 20px;
                                text: "Section: \{switch_state ? maintenance_section : ""}";
                            }
                            Text {
                                font-size: 20px;
                                text: "Block: \{switch_state ? maintenance_block : ""}";
                            }
                            Text {
                                font-size: 20px;
                                text: "Switch Signal: \{switch_state ? "True" : "False"}";
                            }
                        }
                    }
                }    
            }
        }
    }
}
